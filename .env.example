# ---------------------------------------------------------------------------
# TownSync environment configuration
#
# Copy this file to `.env.local` and fill in the values for your project.
# Every variable is optional: when the Firebase variables are missing the
# application boots into the fully interactive local demo mode.
# ---------------------------------------------------------------------------

# Force the local demo repository even when Firebase credentials are present.
VITE_FORCE_DEMO_MODE=false

# --- Firebase Web App credentials (Project settings → Your apps → SDK setup) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
